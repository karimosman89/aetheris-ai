# Aetheris AI — environment variables
# Copy to .env for local dev, or set these in Vercel → Project Settings → Environment Variables.

# Transactional email for the contact form + data-room access requests (Resend).
# If unset, the email step is gracefully skipped.
RESEND_API_KEY=

# Recipient address for inbound leads. Defaults to founder@aetheris.ai if unset.
CONTACT_TO=

# Investor data-room passcode. If unset, the data room stays locked (503) and
# visitors are directed to the "Request access" flow.
DATAROOM_PASSCODE=AETHERIS2026

# HubSpot private-app token for CRM contact upsert (optional).
# If unset, the CRM step is gracefully skipped.
HUBSPOT_TOKEN=
